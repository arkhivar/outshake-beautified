<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/brand_wordmark"
                android:fontFamily="sans-serif-black"
                android:textSize="29sp"
                android:letterSpacing="-0.045"
                android:textColor="@color/on_surface" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:text="@string/settings"
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                app:icon="@drawable/ic_tune"
                app:iconSize="18dp"
                app:iconTint="@color/on_surface"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/brand_tagline"
            android:textSize="12sp"
            android:letterSpacing="0.16"
            android:textColor="@color/on_surface_secondary" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_status"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/status_disconnected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/hero_idle"
            android:fontFamily="sans-serif-black"
            android:textSize="36sp"
            android:letterSpacing="-0.045"
            android:lineSpacingExtra="-2dp"
            android:includeFontPadding="false"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/heroSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/hero_idle_body"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/on_surface_secondary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/courtyard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/coo_name"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/mascotCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coo_idle"
                        android:textColor="@color/on_surface_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <com.outshake.ui.mascot.PigeonView
                    android:id="@+id/pigeonScene"
                    android:layout_width="match_parent"
                    android:layout_height="248dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_feed_coo" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sceneAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:layout_marginHorizontal="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/feed_connect"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp"
                    app:backgroundTint="@color/seed_button"
                    android:textColor="@color/on_seed_button" />
                <TextView
                    android:id="@+id/connectHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="18dp"
                    android:text="@string/shake_hint"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textColor="@color/error"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="22dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/roost_header"
                android:textColor="@color/on_surface"
                android:textStyle="bold"
                android:textSize="20sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/add_server"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/activeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/no_active_profile"
            android:textColor="@color/on_surface_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status"
            android:padding="20dp"
            android:text="@string/roost_empty"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/on_surface_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/footer_note"
            android:textSize="12sp"
            android:textColor="@color/on_surface_secondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
