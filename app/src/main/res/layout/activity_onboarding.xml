<?xml version="1.0" encoding="utf-8"?>
<!-- The whole journey scrolls, including its actions: no weighted, clipped step interiors. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboardingScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/stepCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/on_surface_secondary" />

        <LinearLayout
            android:id="@+id/stepDots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="20dp"
            android:importantForAccessibility="noHideDescendants" />

        <!-- Exactly one live mascot is reused across every step. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/courtyard"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <com.outshake.ui.mascot.PigeonView
                android:id="@+id/pigeonScene"
                android:layout_width="match_parent"
                android:layout_height="228dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/onboarding_demo_accessibility" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/onboarding_demo_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_surface_secondary" />

        <FrameLayout
            android:id="@+id/stepContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">

            <LinearLayout
                android:id="@+id/stepWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/onboarding_welcome_title"
                    android:textAppearance="?attr/textAppearanceHeadlineLarge"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/onboarding_welcome_body"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/on_surface_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/onboarding_notifications_title"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/onboarding_notifications_body"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/on_surface_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/onboarding_battery_title"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/onboarding_battery_body"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/on_surface_secondary" />

                <TextView
                    android:id="@+id/batteryStatusRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/onboarding_battery_granted"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/onboarding_battery_note"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/on_surface_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepShake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/onboarding_shake_title"
                    android:textAppearance="?attr/textAppearanceHeadlineLarge"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/onboarding_shake_body"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/on_surface_secondary" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/primaryButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="56dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:singleLine="false"
            android:text="@string/onboarding_get_started"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/on_seed_button"
            app:backgroundTint="@color/seed_button"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secondaryButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:singleLine="false"
            android:text="@string/onboarding_skip"
            android:textColor="@color/on_surface_secondary"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
