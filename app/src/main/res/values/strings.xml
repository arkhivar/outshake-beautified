    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Outshake</string>
    <string name="onboarding_welcome_body">A VPN you toggle by shaking your phone. One shake connects you — another disconnects. No digging through settings.</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_notifications_title">Keep the shake listener alive</string>
    <string name="onboarding_notifications_body">Outshake listens for shakes in the background so the gesture works from any screen. Android requires a quiet ongoing notification for that — allow notifications so shake-to-toggle keeps working.</string>
    <string name="onboarding_allow_notifications">Allow notifications</string>
    <string name="onboarding_battery_title">Allow background activity</string>
    <string name="onboarding_battery_body">Your phone may put apps to sleep to save battery, which can stop the shake listener. Excluding Outshake from battery optimizations keeps it reliable.</string>
    <string name="onboarding_allow_background">Allow background activity</string>
    <string name="onboarding_battery_granted">Background activity allowed</string>
    <string name="onboarding_battery_note">Note: some manufacturers (Xiaomi, Oppo, Vivo and others) also require enabling "Autostart" for Outshake in system settings.</string>
    <string name="onboarding_shake_title">Shake to toggle</string>
    <string name="onboarding_shake_body">Give your phone a quick double-shake to connect or disconnect. If it triggers too easily — or not at all — adjust the sensitivity in Settings.</string>
