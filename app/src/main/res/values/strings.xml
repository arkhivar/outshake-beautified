    <string name="shake_toggle">Shake to connect / disconnect</string>
    <string name="shake_sensitivity">Shake sensitivity</string>
    <string name="shake_explainer">Lower = easier to trigger. A ~5s cooldown reduces repeated toggles. Background detection is best-effort and may stop during sleep or battery restrictions. The sound and message acknowledge a request, not a working VPN connection.</string>
    <string name="vibrate_on_toggle">Vibrate on toggle</string>
    <string name="vibrate_explainer">Feel a short tick when the VPN toggles — one tap for on, a double tap for off. Fires whether you toggle by shake, the button, or the quick-settings tile.</string>
    <string name="connect_on_boot">Connect on boot</string>
    <string name="boot_explainer">Automatically connect the active profile after the device restarts. VPN permission must already be granted (open the app once and connect); if it isn\'t, a notification will ask you to grant it.</string>
    <string name="sensitivity_high">High (easy to trigger)</string>
    <string name="sensitivity_low">Low (firm shake required)</string>
    <string name="sensitivity_medium">Medium</string>
